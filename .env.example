# ============================================================================
# LLM gateway (opencode-compatible)
# ============================================================================
# OpenCode Zen API key from https://opencode.ai/auth — the default provider.
OPENCODE_API_KEY=

# Provider to use: zen | openai | anthropic | openrouter | ollama | custom
GATEWAY_PROVIDER=zen

# Default model id used by jobagent when none is passed.
# Any model id accepted by the provider works, e.g. gpt-5.4-mini,
# claude-sonnet-4-6, deepseek-v4-flash, gpt-5.5.
GATEWAY_MODEL=gpt-5.4-mini
GATEWAY_BASE_URL=

# Custom OpenAI/Anthropic-compatible provider (only used when GATEWAY_PROVIDER=custom)
# GATEWAY_CUSTOM_PROTOCOL=openai-compatible   # openai-compatible | anthropic
# GATEWAY_CUSTOM_BASE_URL=https://llm.example.com/v1
# GATEWAY_CUSTOM_API_KEY=sk-...

# Optional keys for other providers (swap GATEWAY_PROVIDER to use them)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Robustness / cost controls
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4
LLM_COST_LIMIT_USD=10.0

# ============================================================================
# Job sources
# ============================================================================
# Comma-separated ids: remotive, greenhouse, lever, usajobs
JOB_SOURCES=remotive,greenhouse,lever

# Greenhouse boards to query (public board slugs) and Lever companies
GREENHOUSE_BOARDS=github,stripe,airbnb,lyft,pinterest,doordash,instacart,brex,snowflow
LEVER_COMPANIES=shopify,speakeasy,argyle,asana,notion,deel,mercury

# Optional free key for USAJobs (https://developer.usajobs.gov/)
USAJOBS_API_KEY=
USAJOBS_EMAIL=you@example.com

# ============================================================================
# Serve / CLI
# ============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Optional bearer key protecting the HTTP API. Empty disables auth.
SERVER_API_KEY=
SERVER_RATE_LIMIT_PER_MIN=60

# Output
REPORT_DIR=reports